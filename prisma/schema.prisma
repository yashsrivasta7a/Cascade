// Flowsmith - AI Workflow Orchestration Platform
// Prisma Schema for PostgreSQL (Neon)

generator client {
  provider      = "prisma-client-js"
  // Include binary targets for local dev, Vercel serverless, and Trigger.dev
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_WFO29IUfqEXB@ep-odd-bread-admxn4nd-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require"
}

// =============================================================================
// USER & AUTH (Clerk integration)
// =============================================================================

model User {
  id        String   @id // Clerk user ID
  email     String   @unique
  credits   Int      @default(1000000) // Default 1M credits for new users ($1.00 value)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflows          Workflow[]
  executions         WorkflowExecution[]
  creditTransactions CreditTransaction[]
  apiKeys            ApiKey[]

  @@map("users")
}

// =============================================================================
// API KEYS (for external API access)
// =============================================================================

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  
  // Key identification
  name        String    // User-friendly name (e.g., "Production", "Development")
  prefix      String    // First 8 chars of key for display (e.g., "sk_live_a1b2")
  hashedKey   String    @unique // SHA-256 hash of the full key
  
  // Permissions & limits
  scopes      String[]  @default(["*"]) // Future: granular permissions
  rateLimit   Int       @default(100) // Requests per minute
  
  // Usage tracking
  lastUsedAt  DateTime?
  usageCount  Int       @default(0)
  
  // Lifecycle
  expiresAt   DateTime? // Optional expiration
  revokedAt   DateTime? // Soft delete - when key was revoked
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hashedKey])
  @@index([prefix])
  @@map("api_keys")
}

// =============================================================================
// WORKFLOWS
// =============================================================================

model Workflow {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  
  // Serialized React Flow state
  nodesJson   Json     // Node[] from React Flow
  edgesJson   Json     // Edge[] from React Flow
  viewportJson Json?   // Viewport state
  
  // Versioning
  version     Int      @default(1)
  isPublished Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]
  versions   WorkflowVersion[]

  @@index([userId])
  @@map("workflows")
}

// =============================================================================
// WORKFLOW VERSIONS (Version Control)
// =============================================================================

model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  
  // Version number (auto-incremented per workflow)
  version     Int
  
  // Snapshot of workflow at this version
  name        String
  nodesJson   Json
  edgesJson   Json
  viewportJson Json?
  
  // Optional commit message/label
  message     String?
  
  // Node count for quick display
  nodeCount   Int      @default(0)
  
  createdAt   DateTime @default(now())
  
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

// =============================================================================
// WORKFLOW EXECUTIONS
// =============================================================================

enum ExecutionStatus {
  PENDING
  RUNNING
  PAUSED     // Waiting for webhook
  COMPLETED
  FAILED
  CANCELLED
}

model WorkflowExecution {
  id           String          @id @default(cuid())
  workflowId   String
  userId       String
  
  // Trigger.dev run ID for durability
  triggerRunId String?         @unique
  
  status       ExecutionStatus @default(PENDING)
  
  // Snapshot of workflow at execution time
  workflowSnapshot Json
  
  // Cost tracking
  estimatedCost Int            @default(0)
  actualCost    Int            @default(0)
  
  // Timing
  startedAt    DateTime?
  completedAt  DateTime?
  
  // Error info
  error        String?
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeExecutions NodeExecution[]

  @@index([workflowId])
  @@index([userId])
  @@index([triggerRunId])
  @@map("workflow_executions")
}

// =============================================================================
// NODE EXECUTIONS
// =============================================================================

enum NodeExecutionStatus {
  PENDING
  QUEUED
  RUNNING
  WAITING    // Waiting for webhook callback
  COMPLETED
  FAILED
  SKIPPED
}

model NodeExecution {
  id                  String              @id @default(cuid())
  workflowExecutionId String
  
  // Node identification
  nodeId              String              // React Flow node ID
  nodeType            String              // AINodeType
  nodeLabel           String?
  
  // Trigger.dev task tracking
  triggerTaskId       String?
  waitToken           String?             // Token for wait.forToken()
  
  // Provider info
  providerUsed        String?             // Which provider executed this node
  providerJobId       String?             // External job ID (e.g., fal.ai request ID)
  
  status              NodeExecutionStatus @default(PENDING)
  
  // Input/Output (validated JSON)
  inputJson           Json?
  outputJson          Json?
  
  // Cost tracking
  estimatedCost       Int                 @default(0)
  actualCost          Int                 @default(0)
  
  // Timing
  startedAt           DateTime?
  completedAt         DateTime?
  
  // Logs and errors
  logs                Json?               // Array of log entries
  error               String?
  
  // Retry tracking
  attemptNumber       Int                 @default(1)
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  workflowExecution   WorkflowExecution   @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)

  @@index([workflowExecutionId])
  @@index([nodeId])
  @@index([waitToken])
  @@index([providerJobId])
  @@map("node_executions")
}

// =============================================================================
// PROVIDER WEBHOOKS (for tracking incoming callbacks)
// =============================================================================

model ProviderWebhook {
  id              String   @id @default(cuid())
  
  provider        String   // "fal", "elevenlabs", etc.
  providerJobId   String   // External job ID
  
  // Raw webhook payload
  payloadJson     Json
  
  // Processing status
  processed       Boolean  @default(false)
  processedAt     DateTime?
  
  createdAt       DateTime @default(now())

  @@index([provider, providerJobId])
  @@map("provider_webhooks")
}

// =============================================================================
// QUICK EXECUTIONS (for single node runs without a saved workflow)
// =============================================================================

model QuickExecution {
  id            String   @id @default(cuid())
  userId        String?  // Optional - may not have auth in dev
  
  // Workflow context (optional - for filtering by workflow in Activity tab)
  workflowId    String?  // Workflow this node belongs to
  nodeId        String?  // React Flow node ID
  
  nodeType      String   // AINodeType
  nodeLabel     String?  // Custom label if any
  
  status        String   @default("RUNNING") // RUNNING, COMPLETED, FAILED
  
  // Input/Output
  inputJson     Json?
  outputJson    Json?
  
  // Provider info
  provider      String?  // e.g., "openrouter", "fal"
  model         String?  // e.g., "openai/gpt-4o-mini"
  
  // Cost tracking
  estimatedCost Int      @default(0)
  actualCost    Int      @default(0)
  
  // Timing
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  
  // Duration in ms
  durationMs    Int?
  
  // Error info
  error         String?
  
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([nodeType])
  @@index([startedAt])
  @@index([workflowId])
  @@map("quick_executions")
}

// =============================================================================
// CREDIT TRANSACTIONS (Ledger for all credit changes)
// =============================================================================

enum CreditTransactionType {
  PURCHASE    // User bought credits
  EXECUTION   // Credits deducted for node execution
  REFUND      // Credits refunded (failed execution, etc.)
  BONUS       // Free credits (signup, promo, etc.)
  ADJUSTMENT  // Manual admin adjustment
}

model CreditTransaction {
  id              String                @id @default(cuid())
  userId          String
  
  // Transaction details
  amount          Int                   // Positive = credit, Negative = debit
  balanceAfter    Int                   // User's balance after this transaction
  
  // Transaction type
  type            CreditTransactionType
  
  // Reference to what caused this (optional)
  workflowExecutionId String?
  nodeExecutionId     String?
  
  // Metadata
  description     String?               // Human-readable description
  metadata        Json?                 // Additional data (provider, model, nodeType, etc.)
  
  createdAt       DateTime              @default(now())
  
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workflowExecutionId])
  @@index([createdAt])
  @@map("credit_transactions")
}

// =============================================================================
// NODE RESULT CACHE (for caching identical node executions)
// =============================================================================

model NodeResultCache {
  id        String   @id @default(cuid())
  
  // Hash of nodeType + inputs for cache lookup
  hash      String   @unique
  
  // What node type this is for
  nodeType  String
  
  // Cached output JSON
  output    Json
  
  // TTL management
  createdAt DateTime @default(now())
  expiresAt DateTime
  
  @@index([hash])
  @@index([expiresAt])
  @@map("node_result_cache")
}
