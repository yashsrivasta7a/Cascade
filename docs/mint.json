{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Flowsmith",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#3B82F6",
    "light": "#60A5FA",
    "dark": "#2563EB",
    "background": {
      "dark": "#0a0a0a",
      "light": "#F8F9FB"
    },
    "anchors": {
      "from": "#3B82F6",
      "to": "#3B82F6"
    }
  },
  "theme": "quill",
  "layout": "topnav",
  "modeToggle": {
    "default": "dark",
    "isHidden": false
  },
  "rounded": "default",
  "font": {
    "headings": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "topbar": {
    "style": "gradient"
  },
  "topbarLinks": [
    {
      "name": "Dashboard",
      "url": "https://flowsmiths.vercel.app/dashboard"
    },
    {
      "name": "Changelog",
      "url": "https://flowsmiths.vercel.app/changelog"
    }
  ],
  "topbarCtaButton": {
    "name": "Get Started",
    "url": "https://flowsmiths.vercel.app/sign-up",
    "style": "pill"
  },
  "styling": {
    "codeBlock": "dark"
  },
  "css": "/custom.css",
  "tabs": [
    {
      "name": "Documentation",
      "url": "/"
    },
    {
      "name": "API Reference",
      "url": "api-reference"
    }
  ],
  "navigation": [
    {
      "group": "Getting Started",
      "pages": [
        "introduction",
        "quickstart",
        "authentication"
      ]
    },
    {
      "group": "API Reference",
      "pages": [
        "api-reference/introduction",
        {
          "group": "Workflows",
          "pages": [
            "api-reference/workflows/list",
            "api-reference/workflows/get",
            "api-reference/workflows/create",
            "api-reference/workflows/update",
            "api-reference/workflows/delete",
            "api-reference/workflows/duplicate",
            "api-reference/workflows/execute"
          ]
        },
        {
          "group": "Executions",
          "pages": [
            "api-reference/executions/list",
            "api-reference/executions/get",
            "api-reference/executions/cancel",
            "api-reference/executions/stream"
          ]
        },
        {
          "group": "Nodes",
          "pages": [
            "api-reference/nodes/execute",
            "api-reference/nodes/status",
            "api-reference/nodes/llm-realtime"
          ]
        },
        {
          "group": "Media",
          "pages": [
            "api-reference/media/upload"
          ]
        },
        {
          "group": "Credits",
          "pages": [
            "api-reference/credits/balance",
            "api-reference/credits/stats"
          ]
        },
        {
          "group": "Dashboard",
          "pages": [
            "api-reference/dashboard/stats"
          ]
        }
      ]
    }
  ],
  "footerSocials": {
    "github": "https://github.com/bluerocketdev/workflow-yash"
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "api": {
    "baseUrl": "https://flowsmiths.vercel.app/api/v1",
    "auth": {
      "method": "bearer",
      "name": "Authorization"
    },
    "playground": {
      "mode": "show"
    }
  }
}
